# Node.js API Config
PORT=4000
NODE_ENV=development

# Local PostgreSQL (Docker Service Name 'postgres' ကို သုံးပါ)
DATABASE_URL=postgresql://postgres:password123@postgres:5432/ayar_farm_db

# Local Redis (Docker Service Name 'redis' ကို သုံးပါ)
REDIS_URL=redis://redis:6379

# Local Qdrant (Docker Service Name 'qdrant' ကို သုံးပါ)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Internal Webhook Security
WEBHOOK_SECRET=local_secret_token_123

# AI Model Configuration
AI_ENVIRONMENT=local
LOCAL_LLM_URL=http://ollama:11434
LLM_MODEL_NAME=qwen2.5:7b
EMBEDDING_MODEL_NAME=bge-m3