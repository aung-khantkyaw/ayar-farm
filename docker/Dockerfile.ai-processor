FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies for PDF processing, OCR, and other libraries
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    poppler-utils \
    libssl3 \
    ca-certificates \
    libpq-dev \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY ai-processor/requirements.txt ./

RUN pip install --no-cache-dir -r requirements.txt

COPY ai-processor/ ./

EXPOSE $PORT

CMD ["python", "-u", "main.py"]
