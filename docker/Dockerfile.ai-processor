FROM python:3.14-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies for PDF processing, OCR, and other libraries
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    poppler-utils \
    libssl3 \
    ca-certificates \
    libpq-dev \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY ai-processor/requirements.txt ./

RUN pip install --no-cache-dir -r requirements.txt

COPY ai-processor/ ./

# Embeddings (BAAI/bge-m3) and LLM (qwen2.5:7b) are served by the Ollama container.
# Pull models after startup:
#   docker compose exec ollama ollama pull bge-m3
#   docker compose exec ollama ollama pull qwen2.5:7b

EXPOSE 8001

CMD ["python", "-u", "main.py"]
